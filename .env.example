# ==============================================================================
# VMIND FRONTEND (Next.js) - Variables d'environnement
# ==============================================================================

# URL de l'API Backend VMIND (sur le port 3001 en HTTPS local ou via ngrok en production).
NEXT_PUBLIC_API_URL=https://localhost:3001

# Identifiant du tenant/client actif affiché par défaut dans le tableau de bord (ex: DEMO, TUNISHIP).
NEXT_PUBLIC_CLIENT_ID=DEMO

# Clé publique du widget Cloudflare Turnstile pour la vérification captcha côté client.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAADt4SzHzPF9IYUqX"
